    {
      "name": "03. Works",
      "item": [
        {
          "name": "List Works (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns paginated items\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.items).to.be.an(\"array\");",
                  "    if (json.items.length > 0) {",
                  "        pm.collectionVariables.set(\"sample_work_id\", json.items[0].work_id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/works?page=1&page_size=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "works"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            },
            "description": "Lists works with multi-attribute filtering, pagination, and server-side RBAC scoping."
          }
        },
