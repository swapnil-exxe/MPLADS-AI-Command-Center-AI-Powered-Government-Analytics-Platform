      "name": "00. Authentication & RBAC",
      "item": [
        {
          "name": "Login - Ministry Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Token returned and saved to variable\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.access_token).to.be.a(\"string\");",
                  "    pm.expect(json.role).to.eql(\"MINISTRY\");",
                  "    pm.collectionVariables.set(\"bearer_token\", json.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ministry@mplads.gov.in\",\n  \"password\": \"Mplads@Demo2026#\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticates as Central MoSPI Administrator (unrestricted national scope). Automatically saves access_token to collection variable."
          }
        },
